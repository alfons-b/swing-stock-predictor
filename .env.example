# Salin ke .env untuk development lokal. JANGAN commit .env (sudah di .gitignore).
# Production: isi nilai-nilai ini sebagai GitHub Secrets / Variables, bukan file.

APP_ENV=development
# Development: SQLite lokal. Production: connection string Supabase (Session pooler, port 5432).
DATABASE_URL=sqlite:///data/local.db
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opsional — hanya bila memakai Supabase Storage untuk model/report (MODEL_STORAGE=supabase)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=swing-artifacts
MODEL_STORAGE=auto
REPORT_STORAGE=auto

# Provider data
YAHOO_ENABLED=true
MARKET_DATA_API_KEY=
CSV_DATA_DIR=data/raw/sample

PORTFOLIO_VALUE=100000000
LOG_LEVEL=INFO

# Notifikasi opsional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
