# Salin ke .env untuk development lokal. JANGAN commit .env (sudah di .gitignore).
# Production: isi nilai-nilai ini sebagai GitHub Secrets / Variables, bukan file.

APP_ENV=development
# Development: SQLite lokal.
DATABASE_URL=sqlite:///data/local.db
# Production: database PostgreSQL TERPISAH di Neon (bukan project Supabase yang dipakai aplikasi lain).
# Ambil dari Neon Console → project → Connect. Untuk GitHub Actions pakai connection string DIRECT (tanpa "-pooler").
# DATABASE_URL=postgresql://<role>:<password>@ep-<nama>-<id>.<region>.aws.neon.tech/<database>?sslmode=require
# Batas ukuran: default otomatis dari provider (Neon 950 MB efektif). Isi angka (MB) hanya setelah upgrade paket.
# DB_SIZE_LIMIT_MB=

# Penyimpanan model/report: auto = tabel database bila DATABASE_URL PostgreSQL, folder lokal bila SQLite.
MODEL_STORAGE=auto
REPORT_STORAGE=auto

# Provider data
YAHOO_ENABLED=true
MARKET_DATA_API_KEY=
CSV_DATA_DIR=data/raw/sample

# Riset (opsional, semua boleh kosong — modul memberi label UNAVAILABLE/INSUFFICIENT_DATA)
FUNDAMENTAL_API_KEY=
FUNDAMENTAL_CSV_DIR=data/raw/fundamentals
FOREIGN_FLOW_DIR=data/raw/foreign_flow
FOREIGN_FLOW_CSV_DIR=data/raw/foreign_flow_csv
FOREIGN_FLOW_API_URL=
FOREIGN_FLOW_API_KEY=
FX_FILE=data/raw/fx/fx_rates.csv

PORTFOLIO_VALUE=100000000
LOG_LEVEL=INFO

# Notifikasi opsional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
